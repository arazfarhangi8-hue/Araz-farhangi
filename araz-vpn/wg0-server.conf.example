[Interface]
# Replace with the server private key generated by WireGuard.
PrivateKey = SERVER_PRIVATE_KEY
Address = 10.77.0.1/24
ListenPort = 51820

# Example client peer. Replace with the client's public key.
# Keep private keys out of GitHub.
[Peer]
PublicKey = CLIENT_PUBLIC_KEY
AllowedIPs = 10.77.0.2/32
